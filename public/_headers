/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Alpine.js v3 requires 'unsafe-eval' (uses new Function() for expression evaluation).
  # Google Fonts allowed via style-src fonts.googleapis.com and font-src fonts.gstatic.com.
  # script-src data: is for Astro's ClientRouter, which appends an empty
  # `data:application/javascript,` module to force inline module scripts to run
  # in order after a view transition. Alongside 'unsafe-inline' it grants nothing new.
  # Cloudflare Web Analytics is enabled on the project, so its beacon needs both
  # a script-src for the file and a connect-src for where it reports.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Content-hashed asset bundles — safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

# Service worker + manifest — always revalidate; ETag turns unchanged into 304
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages — not content-hashed; revalidate on every visit
/
  Cache-Control: public, max-age=0, must-revalidate

/calendar/
  Cache-Control: public, max-age=0, must-revalidate

/courses/
  Cache-Control: public, max-age=0, must-revalidate

/information/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Pre-generated calendar downloads — short TTL, revalidate
/ics/*
  Cache-Control: public, max-age=3600, must-revalidate

# Favicons — rarely change; 1 day
/favicon/*
  Cache-Control: public, max-age=86400
