---
import type { SeasonKey, MonthDef } from '../lib/calendar-data';
import { MONTHS, SEASON_META } from '../lib/calendar-data';
import CalendarMonth from './CalendarMonth.astro';

interface Props {
  season: SeasonKey;
}
const { season } = Astro.props;
const meta = SEASON_META[season];

// Preserve original month indices so click handlers can identify a source month.
const items: Array<{ month: MonthDef; monthIdx: number }> = MONTHS
  .map((month, monthIdx) => ({ month, monthIdx }))
  .filter(({ month }) => month.season === season);
---

<section
  id={`season-${season}`}
  class="season"
  aria-labelledby={`season-${season}-name`}
>
  <header class="season__head">
    <p class="season__no" aria-hidden="true">{meta.no}</p>
    <h2 id={`season-${season}-name`} class="season__name">
      <a href={`#season-${season}`} class="season__anchor">{meta.name}</a>
    </h2>
    <p class="season__sub">{meta.sub}</p>
  </header>

  <div class="season__grid">
    {items.map(({ month, monthIdx }) => (
      <CalendarMonth month={month} monthIdx={monthIdx} />
    ))}
  </div>
</section>

<style>
  .season__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(0.75rem, 1.8vw, 1.125rem);
    border-bottom: 0.0625rem solid var(--tana);
    padding-bottom: 0.625rem;
  }

  .season__no {
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
    background: var(--matisse);
    color: #fff;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-weight: 700;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0;
  }

  .season__name {
    font-weight: 800;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    line-height: 2.125rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--prussian-blue);
    margin: 0;
  }

  .season__anchor {
    color: inherit;
    text-decoration: none;
    position: relative;
  }

  .season__anchor::after {
    content: '#';
    margin-left: 0.35em;
    color: var(--driftwood);
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .season__anchor:hover::after,
  .season__anchor:focus-visible::after {
    opacity: 0.55;
  }

  .season__anchor:focus-visible {
    outline: 0.125rem solid var(--matisse);
    outline-offset: 0.1875rem;
    border-radius: 0.125rem;
  }

  .season__sub {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(0.625rem, 1.1vw, 0.75rem);
    line-height: 2.125rem;
    letter-spacing: 0.12em;
    color: #8a7f68;
    font-weight: 700;
    margin: 0 0 0 auto;
  }

  .season__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.625rem), 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.125rem);
  }
</style>
