---
interface Props {
  concentrations: Array<{ key: string; label: string; short: string }>;
}
const { concentrations } = Astro.props;
---

<!--
  Legend and filter in one: each switch is its concentration's colour, faded
  when off and solid when on. Filtering itself is CSS, driven by the show-*
  classes this component's Alpine root puts on .courses-app, so no per-card
  bindings are needed.
-->
<aside class="cfilter" role="toolbar" aria-label="Filter courses by concentration">
  <div class="cfilter-group">
    <slot />

    <p class="cfilter-label" id="cfilter-label">CONCENTRATION</p>

    <div class="cfilter-switches" role="group" aria-labelledby="cfilter-label">
      {concentrations.map((c) => (
        <button
          type="button"
          class={`cfilter-toggle tog-${c.key}`}
          role="switch"
          :class={`{ 'is-on': conc['${c.key}'] }`}
          @click={`toggle('${c.key}')`}
          :aria-checked={`conc['${c.key}'] ? 'true' : 'false'`}
        >
          <span class="cfilter-toggle-label">{c.label}</span>
          <span class="cfilter-track" aria-hidden="true"><span class="cfilter-thumb"></span></span>
        </button>
      ))}
    </div>

    <button type="button" class="cfilter-clear" @click="clearOrShowAll()">
      <span class="cfilter-clear-text" x-text="anyOn ? 'clear all' : 'show all'">clear all</span>
      <span class="cfilter-clear-x" x-text="anyOn ? '✕' : '+'" aria-hidden="true">✕</span>
    </button>
  </div>
</aside>

<style>
  /* Full-bleed out of the app's padding, so the rules span the page the way
     the calendar's filter bar does */
  .cfilter {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(244, 241, 234, 0.94);
    backdrop-filter: blur(0.5rem);
    -webkit-backdrop-filter: blur(0.5rem);
    border-top: 0.0625rem solid var(--tana);
    border-bottom: 0.0625rem solid var(--tana);
    margin: clamp(0.875rem, 2vw, 1.375rem) calc(-1 * clamp(0.875rem, 3.5vw, 2.5rem)) 0;
    padding: 0.75rem clamp(0.875rem, 3.5vw, 2.5rem);
  }

  .cfilter-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 0.5rem 0.9375rem;
    border: 0.0625rem solid rgba(0, 37, 84, 0.1);
    border-radius: 0.625rem;
    background: rgba(255, 255, 255, 0.55);
  }

  .cfilter-label {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--driftwood);
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
  }

  /* Equal columns rather than flex: with `width: max-content`, three 1fr
     tracks each resolve to the widest switch, so the labels and their tracks
     line up instead of sitting ragged once they wrap */
  .cfilter-switches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: max-content;
    gap: 0.25rem 1.75rem;
  }

  @media (max-width: 56rem) {
    .cfilter-switches {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Kept last in the sheet: these rules and the base ones they override match
     on specificity, so whichever comes later wins. Sitting mid-sheet, the
     padding below was silently losing to .cfilter-toggle's own shorthand.

     display: contents drops the grid box so the switches become flex items of
     the bar itself. They then flow inline after the label and wrap where they
     run out of room, instead of sitting as one fixed-width column beside it.
     min-width keeps them equal, which the grid was handling before. */
  @media (max-width: 45rem) {
    .cfilter-switches {
      display: contents;
    }

    .cfilter-toggle {
      min-width: 8.125rem;
    }

    /* Paired with its concentration class to outweigh .cfilter-toggle's own
       `padding` shorthand, which is declared later in this sheet and would
       otherwise win the tie on source order */
    .tog-cl.cfilter-toggle,
    .tog-bl.cfilter-toggle,
    .tog-ilt.cfilter-toggle {
      padding-block: 0.125rem;
    }

    .cfilter-toggle-label {
      line-height: 1.15;
    }

    /* Tight between switches, so the looser gap under the sort row reads as
       the break between the two controls rather than as more of the same */
    .cfilter-group {
      column-gap: 0.5rem;
      row-gap: 0.125rem;
    }

    /* Each switch already carries its concentration's name, so the group
       label is redundant on a phone and costs the width of a whole switch.
       Hidden visually only: aria-labelledby still names the group with it. */
    .cfilter-label {
      position: absolute;
      width: 0.0625rem;
      height: 0.0625rem;
      padding: 0;
      margin: -0.0625rem;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  /* Only three switches here, so they stand on their own: no pill container,
     just the label and its coloured track */
  .cfilter-toggle {
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0;
    border: 0;
    background: none;
    color: var(--prussian-blue);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: color 0.3s linear;
  }

  .cfilter-toggle:focus-visible {
    outline: 0.125rem solid var(--matisse);
    outline-offset: 0.25rem;
    border-radius: 0.25rem;
  }

  /* Takes up the slack in an equal-width button, so every switch sits flush
     at the right edge and the column of them lines up */
  .cfilter-toggle-label {
    flex: 1;
    text-align: left;
  }

  .cfilter-track {
    position: relative;
    display: inline-block;
    width: 1.625rem;
    height: 0.875rem;
    border-radius: 62.4375rem;
    flex: none;
    transition: background 0.3s linear;
  }

  .cfilter-thumb {
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0.0625rem 0.125rem rgba(0, 0, 0, 0.25);
    transition: left 0.3s linear;
  }

  .cfilter-toggle.is-on .cfilter-thumb {
    left: 0.875rem;
  }

  /* Each switch is its concentration's colour: faded off, solid on */
  .tog-cl  .cfilter-track { background: color-mix(in srgb, var(--stiletto) 30%, transparent); }
  .tog-bl  .cfilter-track { background: color-mix(in srgb, var(--matisse) 30%, transparent); }
  .tog-ilt .cfilter-track { background: color-mix(in srgb, var(--sky) 40%, transparent); }

  .tog-cl.is-on  .cfilter-track { background: var(--stiletto); }
  .tog-bl.is-on  .cfilter-track { background: var(--matisse); }
  .tog-ilt.is-on .cfilter-track { background: var(--sky); }

  .cfilter-clear {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--driftwood);
    background: transparent;
    border: 0;
    padding: 0.25rem;
    cursor: pointer;
  }

  /* Underline the words only: the ✕ / + glyph shouldn't be struck through */
  .cfilter-clear-text {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .cfilter-clear:hover {
    color: var(--prussian-blue);
  }

  /* Sits at the far right of whichever row it lands on, so it reads as the
     bar's action rather than as a fourth switch trailing the third */
  @media (max-width: 45rem) {
    .cfilter-clear {
      margin-left: auto;
    }
  }
</style>
