---
import MainNav from './MainNav.astro';
---
<header class="cal-masthead">
  <div class="masthead-logos">
    <img src="/images/gpllm-logo.svg" alt="GPLLM" class="masthead-gpllm-mark" />
    <img
      src="/images/jackman-law-logo.png"
      alt="Henry N.R. Jackman Faculty of Law, University of Toronto"
      class="masthead-uoft-mark"
    />
  </div>

  <MainNav />
</header>

<style>
  .cal-masthead {
    padding: clamp(1.125rem, 3vw, 2rem) 0 0;
  }

  .masthead-logos {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .masthead-gpllm-mark {
    height: clamp(5.25rem, 10vw, 7.5rem);
    width: auto;
    display: block;
  }

  .masthead-uoft-mark {
    height: clamp(3rem, 5.8vw, 4.25rem);
    width: auto;
    display: block;
  }
</style>
