---
---
<header class="cal-header">
  <div class="header-logos">
    <img src="/images/gpllm-logo.png" alt="GPLLM" class="header-gpllm-mark" />
    <img
      src="/images/uoft-law-logo.png"
      alt="Henry N.R. Jackman Faculty of Law, University of Toronto"
      class="header-uoft-mark"
    />
  </div>

  <div class="header-title-row">
    <hgroup>
      <p class="header-year">
        <time datetime="2026-09/2027-08">2026 — 2027 ACADEMIC YEAR</time>
      </p>
      <h1 class="header-title">Program Calendar</h1>
    </hgroup>
    <p class="header-desc">
      Regular classes take place on <strong>Friday evenings</strong> (4–9pm) and
      <strong>Saturdays</strong> (8:30am–6:30pm). Select any coloured date for details,
      or open the key to filter by session type.
    </p>
  </div>
</header>

<style>
  .cal-header {
    padding: clamp(1.125rem, 3vw, 2rem) 0 clamp(0.875rem, 2vw, 1.375rem);
  }

  .header-logos {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header-gpllm-mark {
    height: clamp(4.75rem, 9vw, 6.75rem);
    width: auto;
    display: block;
  }

  .header-uoft-mark {
    height: clamp(3.375rem, 6.6vw, 4.875rem);
    width: auto;
    display: block;
  }

  .header-title-row {
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    border-top: 0.125rem solid var(--prussian-blue);
    padding-top: clamp(0.75rem, 1.6vw, 1.125rem);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .header-title-row hgroup {
    margin: 0;
  }

  .header-year {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: clamp(0.625rem, 1.1vw, 0.75rem);
    letter-spacing: 0.24em;
    color: var(--driftwood);
    font-weight: 700;
    margin: 0;
  }

  .header-title {
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.015em;
    font-size: clamp(1.5625rem, 3.9vw, 2.4375rem);
    margin: 0.375rem 0 0;
    text-transform: uppercase;
    color: var(--prussian-blue);
  }

  .header-desc {
    max-width: 32.5rem;
    font-size: clamp(0.8125rem, 1.4vw, 0.90625rem);
    line-height: 1.35;
    font-weight: 500;
    color: var(--oxford-blue);
    margin: 3rem 0 -0.25rem;
    align-self: flex-end;
  }

  .header-desc strong {
    color: var(--prussian-blue);
  }
</style>
