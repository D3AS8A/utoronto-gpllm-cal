---
import type { MonthDef } from '../lib/calendar-data';
import {
  cellVisual, swatchStyle, weekdayName, calloutStyle,
  META, pickHours, fmtHours, toLocalIso, cssColor, cssVar, itemNote,
} from '../lib/calendar-data';

interface Props {
  month: MonthDef;
  monthIdx: number;
}
const { month, monthIdx } = Astro.props;

const MONTH_NUM: Record<string, number> = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6,
  July: 7, August: 8, September: 9, October: 10, November: 11, December: 12,
};
const monthNum = MONTH_NUM[month.name];
const pad = (n: number) => String(n).padStart(2, '0');
const iso = (day: number) => `${month.year}-${pad(monthNum)}-${pad(day)}`;

// Day-of-week header. `<abbr>` gives screen readers the full name; visual
// display shows the single letter.
const DOW_ABBR: Array<{ letter: string; full: string; weekend: boolean }> = [
  { letter: 'S', full: 'Sunday',    weekend: true  },
  { letter: 'M', full: 'Monday',    weekend: false },
  { letter: 'T', full: 'Tuesday',   weekend: false },
  { letter: 'W', full: 'Wednesday', weekend: false },
  { letter: 'T', full: 'Thursday',  weekend: false },
  { letter: 'F', full: 'Friday',    weekend: false },
  { letter: 'S', full: 'Saturday',  weekend: true  },
];

// Build the day cell grid — rows*7 grid, blanks before the 1st and after the last day.
const total = month.fdow + month.days;
const rows = Math.ceil(total / 7);

type Cell = {
  blank: boolean;
  num: number | null;
  iso: string;
  dow: number;
  cats: string[];
  hasMark: boolean;
  style: string;
  cornerColor?: string;
  ariaLabel: string;
  detail: null | {
    weekday: string;
    dateLabel: string;
    items: Array<{
      name: string;
      time: string;
      swatchStyle: string;
      /** Naive local ISO strings (America/Toronto assumed). Null when no hours. */
      isoStart: string | null;
      isoEnd: string | null;
      /** Day-level free-form note; embedded in ICS/Google Cal description. */
      note: string | null;
    }>;
    headBg: string;
    headFg: string;
    note: string | null;
  };
};

function readableFg(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16);
  const g = parseInt(h.slice(2, 4), 16);
  const b = parseInt(h.slice(4, 6), 16);
  const srgb = [r, g, b].map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
  });
  const lum = 0.2126 * srgb[0] + 0.7152 * srgb[1] + 0.0722 * srgb[2];
  return lum > 0.55 ? cssVar('prussian-blue') : '#fff';
}

const cells: Cell[] = [];
for (let i = 0; i < rows * 7; i++) {
  const day = i - month.fdow + 1;
  const dow = i % 7;
  if (day < 1 || day > month.days) {
    cells.push({ blank: true, num: null, iso: '', dow, cats: [], hasMark: false, style: '', ariaLabel: '', detail: null });
    continue;
  }
  const cats = month.marks[day] || [];
  const hasMark = cats.length > 0;
  const note = month.notes?.[day];
  const v = cellVisual(cats);
  const border = note?.borderColor ? `0.125rem solid ${cssVar(note.borderColor)}` : v.border;
  const style =
    `background:${v.bg};color:${v.fg};border:${border};` +
    (v.outline ? `outline:${v.outline};outline-offset:-0.125rem;` : '') +
    `font-weight:${v.isBold ? '800' : '600'};` +
    `--corner-color:${v.cornerColor ?? 'transparent'};`;
  const dateIso = iso(day);
  const weekday = weekdayName(month.fdow, day);

  let detail: Cell['detail'] = null;
  let ariaLabel = `${weekday}, ${month.name} ${day}`;
  if (hasMark) {
    const seen = new Set<string>();
    const items: NonNullable<Cell['detail']>['items'] = [];
    const ariaParts: string[] = [];
    for (const c of cats) {
      const key = c === 'intb' ? 'intc' : c;
      if (seen.has(key)) continue;
      seen.add(key);
      const m = META[c as keyof typeof META];
      const specific = pickHours(m.hours, dow);
      const time = specific ? fmtHours(specific) : m.time;
      // note.title overrides the primary (first) item's display name
      const displayName = items.length === 0 && note?.title ? note.title : m.name;
      items.push({
        name: displayName,
        time,
        swatchStyle: swatchStyle(m.t, m.c, 20),
        isoStart: specific ? toLocalIso(dateIso, specific.start) : null,
        isoEnd:   specific ? toLocalIso(dateIso, specific.end)   : null,
        note: itemNote(c as keyof typeof META, dow),
      });
      ariaParts.push(specific ? `${displayName}, ${time}` : displayName);
    }
    const rawHeadBg = META[cats[0] as keyof typeof META].c;
    const headBg = cssColor(rawHeadBg);
    const headFg = readableFg(rawHeadBg);
    const noteText = note?.text ?? null;
    detail = {
      weekday,
      dateLabel: `${month.name} ${day}`,
      items,
      headBg,
      headFg,
      note: noteText,
    };
    const ariaTail = noteText ? `${ariaParts.join('; ')}. ${noteText}` : ariaParts.join('; ');
    ariaLabel = `${weekday}, ${month.name} ${day} — ${ariaTail}`;
  }
  cells.push({ blank: false, num: day, iso: dateIso, dow, cats, hasMark, style, cornerColor: v.cornerColor, ariaLabel, detail });
}

const callouts = month.callouts ?? [];
const headingId = `month-${monthIdx}-name`;
---

<article class="month-card" aria-labelledby={headingId}>
  <header class="month-head">
    <h3 id={headingId} class="month-title">
      <span>{month.name}</span>
      <time datetime={month.year} class="month-year">{month.year}</time>
    </h3>
  </header>

  <div class="month-dow-row" role="row" aria-hidden="true">
    {DOW_ABBR.map(({ letter, full, weekend }) => (
      <abbr class:list={['dow', weekend && 'weekend']} title={full}>{letter}</abbr>
    ))}
  </div>

  <div class="month-day-grid" role="grid" aria-label={`${month.name} ${month.year}`}>
    {cells.map((cell) => cell.blank ? (
      <div class="cell blank" role="gridcell" aria-hidden="true"></div>
    ) : cell.hasMark ? (
      <button
        type="button"
        class:list={['cell', 'marked', (cell.dow === 0 || cell.dow === 6) && 'weekend']}
        style={cell.style}
        data-cats={cell.cats.join(' ')}
        data-iso={cell.iso}
        aria-label={cell.ariaLabel}
        :class="{ 'is-dim': isDim($el.dataset.cats) }"
        :style="cellStyle($el.dataset.cats)"
        :aria-describedby={`tooltip.visible && tooltip.activeIso === '${cell.iso}' ? 'cal-tooltip' : null`}
        @click={`openDetail(${JSON.stringify(cell.detail)}, $el)`}
        @mouseenter={`showTooltip('${cell.iso}', ${JSON.stringify(cell.detail)}, $el.getBoundingClientRect())`}
        @mouseleave="hideTooltip()"
        @focus={`showTooltip('${cell.iso}', ${JSON.stringify(cell.detail)}, $el.getBoundingClientRect())`}
        @blur="hideTooltip(0)"
      >
        {cell.cornerColor && <span class="cell-corner" aria-hidden="true"></span>}
        <time datetime={cell.iso}>{cell.num}</time>
      </button>
    ) : (
      <div class:list={['cell', (cell.dow === 0 || cell.dow === 6) && 'weekend']} role="gridcell">
        <time datetime={cell.iso}>{cell.num}</time>
      </div>
    ))}
  </div>

  {callouts.map((co) => (
    <aside class="month-callout" style={calloutStyle(co.tone)}>
      <p class="month-callout-label">{co.label}</p>
      <p class="month-callout-detail">{co.detail}</p>
    </aside>
  ))}
</article>

<style>
  .month-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 0.0625rem solid var(--prussian-blue);
    box-shadow: 0.1875rem 0.1875rem 0 rgba(0, 37, 84, 0.18);
  }

  .month-callout {
    margin: 0 0.5rem 0.625rem;
    padding: 0.5625rem 0.6875rem;
  }

  .month-callout:first-of-type {
    margin-top: auto;
  }

  .month-head {
    padding: 0.625rem 0.75rem 0.5rem;
    border-bottom: 0.0625rem solid var(--prussian-blue);
  }

  .month-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--prussian-blue);
  }

  .month-year {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    color: var(--driftwood);
    font-weight: 700;
  }

  .month-dow-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    padding: 0.5rem 0.5rem 0;
  }

  .dow {
    text-align: center;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.59375rem;
    font-weight: 700;
    color: var(--pewter);
    padding-bottom: 0.3125rem;
    /* Reset <abbr> browser defaults */
    text-decoration: none;
    -webkit-text-decoration: none;
    border-bottom: 0;
    cursor: help;
  }

  .dow.weekend {
    color: var(--driftwood);
  }

  .month-day-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.125rem;
    padding: 0 0.5rem 0.625rem;
  }

  .cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(0.65625rem, 2.4vw, 0.78125rem);
    box-sizing: border-box;
    color: var(--prussian-blue);
    background: transparent;
    border: 0.125rem solid transparent;
    padding: 0;
    overflow: hidden;
    transition: transform 0.08s ease, opacity 0.2s ease, filter 0.2s ease;
  }

  .cell > time {
    position: relative;
    z-index: 2;
  }

  .cell-corner {
    position: absolute;
    inset: 0;
    background: var(--corner-color);
    clip-path: polygon(100% 0.25rem, 100% 100%, 0.25rem 100%);
    z-index: 1;
    pointer-events: none;
  }

  .cell.marked {
    cursor: pointer;
  }

  .cell.marked:active {
    transform: scale(0.86);
  }

  .cell.is-dim {
    opacity: 0.2;
    filter: grayscale(0.6);
  }

  /* Weekend shading — only applied to non-marked weekend cells when
     `rails` is on. Root state adds .rails-on class; cells opt in via
     .cell.weekend but skipped when they already have their own bg. */
  :global(.rails-on) .cell.weekend:not(.marked) {
    background: var(--porcelain);
  }

  .month-callout-label {
    font-weight: 800;
    font-size: 0.71875rem;
    letter-spacing: 0.01em;
    color: var(--prussian-blue);
    margin: 0;
  }

  .month-callout-detail {
    font-size: 0.6875rem;
    line-height: 1.35;
    margin-top: 0.125rem;
    color: var(--umber);
  }
</style>
