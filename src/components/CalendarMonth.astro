---
import type { MonthDef } from '../lib/calendar-data';
import {
  cellVisual, swatchStyle, weekdayName, calloutStyle,
  META, pickHours, fmtHours, toLocalIso,
} from '../lib/calendar-data';

interface Props {
  month: MonthDef;
  monthIdx: number;
}
const { month, monthIdx } = Astro.props;

const MONTH_NUM: Record<string, number> = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6,
  July: 7, August: 8, September: 9, October: 10, November: 11, December: 12,
};
const monthNum = MONTH_NUM[month.name];
const pad = (n: number) => String(n).padStart(2, '0');
const iso = (day: number) => `${month.year}-${pad(monthNum)}-${pad(day)}`;

// Day-of-week header. `<abbr>` gives screen readers the full name; visual
// display shows the single letter.
const DOW_ABBR: Array<{ letter: string; full: string; weekend: boolean }> = [
  { letter: 'S', full: 'Sunday',    weekend: true  },
  { letter: 'M', full: 'Monday',    weekend: false },
  { letter: 'T', full: 'Tuesday',   weekend: false },
  { letter: 'W', full: 'Wednesday', weekend: false },
  { letter: 'T', full: 'Thursday',  weekend: false },
  { letter: 'F', full: 'Friday',    weekend: false },
  { letter: 'S', full: 'Saturday',  weekend: true  },
];

// Build the day cell grid — rows*7 grid, blanks before the 1st and after the last day.
const total = month.fdow + month.days;
const rows = Math.ceil(total / 7);

type Cell = {
  blank: boolean;
  num: number | null;
  iso: string;
  dow: number;
  cats: string[];
  hasMark: boolean;
  style: string;
  cornerColor?: string;
  ariaLabel: string;
  detail: null | {
    weekday: string;
    dateLabel: string;
    items: Array<{
      name: string;
      time: string;
      swatchStyle: string;
      /** Naive local ISO strings (America/Toronto assumed). Null when no hours. */
      isoStart: string | null;
      isoEnd: string | null;
    }>;
    headBg: string;
  };
};

const cells: Cell[] = [];
for (let i = 0; i < rows * 7; i++) {
  const day = i - month.fdow + 1;
  const dow = i % 7;
  if (day < 1 || day > month.days) {
    cells.push({ blank: true, num: null, iso: '', dow, cats: [], hasMark: false, style: '', ariaLabel: '', detail: null });
    continue;
  }
  const cats = month.marks[day] || [];
  const hasMark = cats.length > 0;
  const v = cellVisual(cats);
  const style =
    `background:${v.bg};color:${v.fg};border:${v.border};` +
    (v.outline ? `outline:${v.outline};outline-offset:-2px;` : '') +
    `font-weight:${v.isBold ? '800' : '600'};` +
    `--corner-color:${v.cornerColor ?? 'transparent'};`;
  const dateIso = iso(day);
  const weekday = weekdayName(month.fdow, day);

  let detail: Cell['detail'] = null;
  let ariaLabel = `${weekday}, ${month.name} ${day}`;
  if (hasMark) {
    const seen = new Set<string>();
    const items: NonNullable<Cell['detail']>['items'] = [];
    const ariaParts: string[] = [];
    for (const c of cats) {
      const key = c === 'intb' ? 'intc' : c;
      if (seen.has(key)) continue;
      seen.add(key);
      const m = META[c as keyof typeof META];
      const specific = pickHours(m.hours, dow);
      const time = specific ? fmtHours(specific) : m.time;
      items.push({
        name: m.name,
        time,
        swatchStyle: swatchStyle(m.t, m.c, 20),
        isoStart: specific ? toLocalIso(dateIso, specific.start) : null,
        isoEnd:   specific ? toLocalIso(dateIso, specific.end)   : null,
      });
      ariaParts.push(specific ? `${m.name}, ${time}` : m.name);
    }
    const tone = cats.includes('reg') ? 'blue'
      : cats.some((c) => ['fin', 'mid', 'finc', 'dmid', 'dfin'].includes(c)) ? 'ink'
      : 'brown';
    const headBg = tone === 'ink' ? '#002554' : tone === 'blue' ? '#1f6092' : '#936e42';
    detail = {
      weekday,
      dateLabel: `${month.name} ${day}`,
      items,
      headBg,
    };
    ariaLabel = `${weekday}, ${month.name} ${day} — ${ariaParts.join('; ')}`;
  }
  cells.push({ blank: false, num: day, iso: dateIso, dow, cats, hasMark, style, cornerColor: v.cornerColor, ariaLabel, detail });
}

const callouts = month.callouts ?? [];
const headingId = `month-${monthIdx}-name`;
---

<article class="month-card" aria-labelledby={headingId}>
  <header class="month-card__head">
    <h3 id={headingId} class="month-card__name">
      <span>{month.name}</span>
      <time datetime={month.year} class="month-card__year">{month.year}</time>
    </h3>
  </header>

  <div class="month-card__dow" role="row" aria-hidden="true">
    {DOW_ABBR.map(({ letter, full, weekend }) => (
      <abbr class:list={['dow', weekend && 'dow--weekend']} title={full}>{letter}</abbr>
    ))}
  </div>

  <div class="month-card__grid" role="grid" aria-label={`${month.name} ${month.year}`}>
    {cells.map((cell) => cell.blank ? (
      <div class="cell cell--blank" role="gridcell" aria-hidden="true"></div>
    ) : cell.hasMark ? (
      <button
        type="button"
        class:list={['cell', 'cell--marked', (cell.dow === 0 || cell.dow === 6) && 'cell--weekend']}
        style={cell.style}
        data-cats={cell.cats.join(' ')}
        data-iso={cell.iso}
        aria-label={cell.ariaLabel}
        :class="{ 'is-dim': isDim($el.dataset.cats) }"
        :style="cellStyle($el.dataset.cats)"
        :aria-describedby={`tooltip && tooltip.iso === '${cell.iso}' ? 'cal-tooltip' : null`}
        @click={`openDetail(${JSON.stringify(cell.detail)})`}
        @mouseenter={`showTooltip('${cell.iso}', ${JSON.stringify(cell.detail)}, $el.getBoundingClientRect())`}
        @mouseleave="hideTooltip()"
        @focus={`showTooltip('${cell.iso}', ${JSON.stringify(cell.detail)}, $el.getBoundingClientRect())`}
        @blur="hideTooltip(0)"
      >
        {cell.cornerColor && <span class="cell__corner" aria-hidden="true"></span>}
        <time datetime={cell.iso}>{cell.num}</time>
      </button>
    ) : (
      <div class:list={['cell', (cell.dow === 0 || cell.dow === 6) && 'cell--weekend']} role="gridcell">
        <time datetime={cell.iso}>{cell.num}</time>
      </div>
    ))}
  </div>

  {callouts.map((co) => (
    <aside class="callout" style={calloutStyle(co.tone)}>
      <p class="callout__label">{co.label}</p>
      <p class="callout__detail">{co.detail}</p>
    </aside>
  ))}
</article>

<style>
  .month-card {
    background: #fff;
    border: 1px solid var(--prussian-blue);
    box-shadow: 3px 3px 0 rgba(0, 37, 84, 0.18);
  }

  .month-card__head {
    padding: 10px 12px 8px;
    border-bottom: 1px solid var(--prussian-blue);
  }

  .month-card__name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin: 0;
    font-weight: 800;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--prussian-blue);
  }

  .month-card__year {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--driftwood);
    font-weight: 700;
  }

  .month-card__dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    padding: 8px 8px 0;
  }

  .dow {
    text-align: center;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 9.5px;
    font-weight: 700;
    color: #7d8794;
    padding-bottom: 5px;
    /* Reset <abbr> browser defaults */
    text-decoration: none;
    -webkit-text-decoration: none;
    border-bottom: 0;
    cursor: help;
  }

  .dow--weekend {
    color: var(--driftwood);
  }

  .month-card__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    padding: 0 8px 10px;
  }

  .cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    font-family: 'Archivo', sans-serif;
    font-size: clamp(10.5px, 2.4vw, 12.5px);
    box-sizing: border-box;
    color: var(--prussian-blue);
    background: transparent;
    border: 2px solid transparent;
    padding: 0;
    overflow: hidden;
    transition: transform 0.08s ease, opacity 0.2s ease, filter 0.2s ease;
  }

  .cell > time {
    position: relative;
    z-index: 2;
  }

  .cell__corner {
    position: absolute;
    inset: 0;
    background: var(--corner-color);
    clip-path: polygon(100% 4px, 100% 100%, 4px 100%);
    z-index: 1;
    pointer-events: none;
  }

  .cell--marked {
    cursor: pointer;
  }

  .cell--marked:active {
    transform: scale(0.86);
  }

  .cell.is-dim {
    opacity: 0.2;
    filter: grayscale(0.6);
  }

  /* Weekend shading — only applied to non-marked weekend cells when
     `rails` is on. Root state adds .rails-on class; cells opt in via
     .cell--weekend but skipped when they already have their own bg. */
  :global(.rails-on) .cell--weekend:not(.cell--marked) {
    background: var(--porcelain);
  }

  .callout__label {
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.01em;
    color: var(--prussian-blue);
    margin: 0;
  }

  .callout__detail {
    font-size: 11px;
    line-height: 1.35;
    margin-top: 2px;
    color: #4a4230;
  }
</style>
