---
---
<template x-if="detail">
  <div class="detail-scrim" @click="closeDetail()">
    <div
      x-show="spotlight.active"
      class="detail-spotlight"
      :style="`--sp-x:${spotlight.x}px;--sp-y:${spotlight.y}px;--sp-w:${spotlight.w}px;--sp-h:${spotlight.h}px`"
      aria-hidden="true"
    ></div>
    <article
      class="detail-card"
      @click.stop
      @pointerdown="startCardDrag($event)"
      role="dialog"
      aria-modal="true"
      aria-labelledby="detail-heading"
    >
      <header class="detail-head" :style="`background:${detail.headBg};color:${detail.headFg}`">
        <hgroup>
          <p class="detail-weekday" x-text="detail.weekday"></p>
          <h2 id="detail-heading" class="detail-date-title" x-text="detail.dateLabel"></h2>
        </hgroup>
        <button type="button" class="detail-close" @click="closeDetail()" aria-label="Close">✕</button>
      </header>

      <ul class="detail-body">
        <template x-for="item in detail.items" :key="item.name">
          <li class="detail-item">
            <span class="detail-item-swatch" :style="item.swatchStyle" aria-hidden="true"></span>
            <div class="detail-item-info">
              <p class="detail-item-name" x-text="item.name"></p>
              <p class="detail-item-time" x-text="item.time"></p>
              <div class="detail-item-cta" x-show="item.isoStart">
                <span class="detail-item-cta-label">Add to</span>
                <a
                  class="cta"
                  target="_blank"
                  rel="noopener"
                  :href="googleCalUrl(item)"
                >Google Cal</a>
                <a
                  class="cta"
                  x-show="isApple"
                  :href="appleCalUrl(item)"
                  title="Open this event in the built-in Calendar app"
                >iCal</a>
                <button
                  type="button"
                  class="cta"
                  @click="downloadIcs(item)"
                  title="Download an .ics file for any other calendar app"
                >.ics</button>
              </div>
            </div>
          </li>
        </template>
      </ul>
    </article>
  </div>
</template>

<style>
  .detail-scrim {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(0, 37, 84, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.125rem;
    animation: gpFade 0.16s ease;
  }

  /* Extra dimming everywhere EXCEPT the source month card — box-shadow spills
     outward from a zero-fill rect so the source month reads as a spotlight
     while the rest of the calendar sits under a heavier dim. */
  .detail-spotlight {
    position: fixed;
    left: var(--sp-x, 0);
    top: var(--sp-y, 0);
    width: var(--sp-w, 0);
    height: var(--sp-h, 0);
    pointer-events: none;
    box-shadow: 0 0 0 100vmax rgba(0, 37, 84, 0.20);
  }

  .detail-card {
    position: relative;
    z-index: 1;
    background: #fff;
    width: 100%;
    max-width: 25rem;
    border: 0.125rem solid var(--prussian-blue);
    box-shadow: 0.5rem 0.5rem 0 var(--prussian-blue);
    animation: gpPop 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: grab;
    touch-action: none;
  }

  .detail-card.is-dragging {
    cursor: grabbing;
    user-select: none;
    animation: none;
  }

  .detail-card.is-dragging * {
    user-select: none;
  }

  .detail-card a,
  .detail-card button {
    cursor: pointer;
  }

  .detail-head {
    color: #fff;
    padding: 1rem 1.125rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .detail-weekday {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    opacity: 0.8;
    font-weight: 700;
  }

  .detail-date-title {
    font-weight: 900;
    font-size: 1.625rem;
    line-height: 1;
    margin-top: 0.1875rem;
  }

  .detail-close {
    background: none;
    border: 0.125rem solid currentColor;
    color: inherit;
    width: 2.125rem;
    height: 2.125rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
  }

  .detail-close:active { transform: scale(0.9); }

  .detail-body {
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
  }

  .detail-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .detail-item-swatch { display: block; }

  .detail-item-name {
    font-weight: 800;
    font-size: 0.9375rem;
    color: var(--prussian-blue);
  }

  .detail-item-time {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--pablo);
    margin-top: 0.125rem;
  }

  .detail-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .detail-item-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .detail-item-cta-label {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.65625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--driftwood);
    font-weight: 700;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3125rem 0.625rem;
    border: 0.09375rem solid var(--tana);
    background: #fff;
    color: var(--prussian-blue);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.14s, background 0.14s, color 0.14s;
  }

  .cta:hover {
    border-color: var(--matisse);
    color: var(--matisse);
  }

  .cta:active { transform: scale(0.97); }

  @media (max-width: 30rem) {
    .detail-item-cta { gap: 0.375rem; }
    .detail-item-cta-label { font-size: 0.59375rem; letter-spacing: 0.1em; }
    .cta {
      padding: 0.25rem 0.4375rem;
      font-size: 0.625rem;
      letter-spacing: 0.02em;
    }
  }
</style>
