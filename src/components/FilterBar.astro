---
import type { FilterDef } from '../lib/calendar-data';
import { FILTERS_CLASSES, FILTERS_EXAMS, META, swatchStyle } from '../lib/calendar-data';

const LABEL: Record<string, string> = {
  reg: 'Regular Classes',
  makeup: 'Make-Up Classes',
  lmc: 'Legal Methods (Canadian Law)',
  lmb: 'Legal Methods (Business Law & ILT)',
  alrw: 'Applied Legal Research & Writing (ALRW)',
  orient: 'Orientation Evenings',
  intensive: 'Intensive Courses',
  mid: 'Mid-Term Exams',
  dmid: 'Deferred Mid-Term Exams',
  fin: 'Final Exams',
  finc: 'Final Exams (Canadian Law)',
  dfin: 'Deferred Final Exams',
};

interface Chip {
  key: string;
  labelHead: string;
  labelTail: string | null;
  swatchStyle: string;
}

function toChip(f: FilterDef): Chip {
  const meta = f.name
    ? { t: f.t!, c: f.c! }
    : { t: META[f.cats[0]].t, c: META[f.cats[0]].c };
  const raw = LABEL[f.key] ?? f.key;
  const idx = raw.indexOf('(');
  const tail = idx > 0 ? raw.slice(idx) : null;
  const wrap = tail !== null && !/^\(\w+\)$/.test(tail);
  const labelHead = wrap ? raw.slice(0, idx).trimEnd() : raw;
  const labelTail = wrap ? tail : null;
  return {
    key: f.key,
    labelHead,
    labelTail,
    swatchStyle: swatchStyle(meta.t, meta.c, 14),
  };
}

const classChips: Chip[] = FILTERS_CLASSES.map(toChip);
const examChips:  Chip[] = FILTERS_EXAMS.map(toChip);
---

<div class="fb__topbar">
  <button
    type="button"
    class="fb__clear"
    @click="reset()"
    x-show="anyFilter && !isDefault"
  >
    <span class="fb__clear-text">clear <span x-text="activeCount"></span> filter<span x-text="activeCount === 1 ? '' : 's'"></span></span> <span class="fb__clear-x">✕</span>
  </button>
</div>

<aside class="fb" :data-tucked="fbHidden ? 'true' : null" role="toolbar" aria-label="Calendar filters">
  <div class="fb__inner">
    <div class="fb__row">
      <div class="fb__group" :class="{ 'is-open': classesOpen }" data-fb-group="classes">
        <button
          type="button"
          class="fb__label"
          @click="classesOpen = !classesOpen"
          :aria-expanded="classesOpen ? 'true' : 'false'"
          aria-controls="fb-classes-content"
        >
          <span class="fb__label-text">CLASSES</span>
          <span class="fb__caret" aria-hidden="true"></span>
        </button>
        <div id="fb-classes-content" class="fb__collapse">
          <div class="fb__collapse-inner">
            <div class="fb__switches">
              {classChips.map((c) => (
                <button
                  type="button"
                  class="tog"
                  role="switch"
                  :class={`{ 'is-on': filters['${c.key}'] }`}
                  @click={`toggle('${c.key}')`}
                  :aria-checked={`filters['${c.key}'] ? 'true' : 'false'`}
                >
                  <span class="tog__swatch" style={c.swatchStyle} aria-hidden="true"></span>
                  <span class="tog__label">
                  {c.labelHead}
                  {c.labelTail && <><br />{c.labelTail}</>}
                </span>
                  <span class="tog__track" aria-hidden="true"><span class="tog__thumb"></span></span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="fb__row">
      <div class="fb__group" :class="{ 'is-open': examsOpen }" data-fb-group="exams">
        <button
          type="button"
          class="fb__label"
          @click="examsOpen = !examsOpen"
          :aria-expanded="examsOpen ? 'true' : 'false'"
          aria-controls="fb-exams-content"
        >
          <span class="fb__label-text">EXAMS</span>
          <span class="fb__caret" aria-hidden="true"></span>
        </button>
        <div id="fb-exams-content" class="fb__collapse">
          <div class="fb__collapse-inner">
            <div class="fb__switches">
              {examChips.map((c) => (
                <button
                  type="button"
                  class="tog"
                  role="switch"
                  :class={`{ 'is-on': filters['${c.key}'] }`}
                  @click={`toggle('${c.key}')`}
                  :aria-checked={`filters['${c.key}'] ? 'true' : 'false'`}
                >
                  <span class="tog__swatch" style={c.swatchStyle} aria-hidden="true"></span>
                  <span class="tog__label">
                  {c.labelHead}
                  {c.labelTail && <><br />{c.labelTail}</>}
                </span>
                  <span class="tog__track" aria-hidden="true"><span class="tog__thumb"></span></span>
                </button>
              ))}
            </div>
            <p class="fb__note">
              Exam times: weekdays 6pm–9pm · weekends 1pm–4pm
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</aside>

<style>
  .fb {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(244, 241, 234, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--tana);
    border-bottom: 1px solid var(--tana);
    margin: 0 calc(-1 * clamp(14px, 3.5vw, 40px));
    padding: 12px clamp(14px, 3.5vw, 40px);
    transition: transform 250ms ease;
    will-change: transform;
  }

  .fb[data-tucked='true'] {
    transform: translateY(-100%);
  }

  .fb__inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fb__row {
    display: block;
  }


  .fb__group {
    display: block;
    padding: 6px 10px;
    border: 1px solid rgba(0, 37, 84, 0.10);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.55);
  }

  .fb__collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s linear;
  }

  .fb__collapse > .fb__collapse-inner {
    min-height: 0;
    overflow: hidden;
    margin-top: 6px;
  }

  .fb__group.is-open .fb__collapse {
    grid-template-rows: 1fr;
  }

  .fb__switches {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--tog-cell-w, 14rem));
    gap: 2px 4px;
  }

  .fb__note {
    margin: 8px 4px 2px;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--driftwood);
  }

  .fb__label {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--driftwood);
    font-weight: 700;
    margin: 0;
    padding: 4px;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    border: 0;
    background: transparent;
    border-radius: 4px;
    text-align: left;
  }

  .fb__label:hover { color: var(--prussian-blue); }

  .fb__label:focus-visible {
    outline: 2px solid var(--matisse);
    outline-offset: 2px;
  }

  .fb__caret {
    display: inline-block;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    transition: transform 0.3s linear;
    transform: rotate(-90deg);
  }

  .fb__group.is-open .fb__caret {
    transform: rotate(0deg);
  }

  /* ---- Filter switch: [swatch] [label] [track+thumb] ---- */

  .tog {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px 6px 10px;
    min-width: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--prussian-blue);
    font-family: 'Archivo', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.3s linear,
      border-color 0.3s linear,
      color 0.3s linear;
  }

  .tog .tog__label { width: var(--tog-label-w, auto); }

  .tog:focus-visible {
    outline: 2px solid var(--matisse);
    outline-offset: 2px;
  }

  .tog.is-on {
    background: rgba(0, 37, 84, 0.06);
    border-color: rgba(0, 37, 84, 0.12);
  }

  .tog__swatch {
    display: inline-block;
    flex: none;
    box-sizing: border-box;
  }

  .tog__label {
    line-height: 1.1;
    min-width: 0;
  }

  .tog__track {
    position: relative;
    display: inline-block;
    width: 26px;
    height: 14px;
    border-radius: 999px;
    background: var(--tana);
    flex: none;
    transition: background 0.3s linear;
  }

  .tog__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: left 0.3s linear;
  }

  .tog.is-on .tog__track {
    background: var(--prussian-blue);
  }

  .tog.is-on .tog__thumb {
    left: 14px;
  }


  /* ---- Clear link ---- */

  .fb__topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 18px;
    padding: 4px clamp(14px, 3.5vw, 40px) 0;
    margin: 0 calc(-1 * clamp(14px, 3.5vw, 40px));
  }

  .fb__clear {
    background: none;
    border: 0;
    padding: 4px 2px;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--matisse);
    cursor: pointer;
    text-decoration: none;
  }

  .fb__clear-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .fb__clear-x {
    display: inline-block;
    margin-left: 4px;
  }

  .fb__clear:hover { color: var(--prussian-blue); }

  /* ---- Mobile: labels go inline, rows left-align ---- */
  @media (max-width: 720px) {
    .fb__row { justify-content: flex-start; }
    .fb__label { flex-basis: 100%; margin-right: 0; padding-bottom: 2px; }
    .fb__row--ctl { justify-content: space-between; gap: 12px; }
  }
</style>
