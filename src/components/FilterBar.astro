---
import type { FilterDef } from '../lib/calendar-data';
import { FILTERS_CLASSES, FILTERS_EXAMS, META, swatchStyle } from '../lib/calendar-data';

const LABEL: Record<string, string> = {
  reg: 'Regular Classes',
  makeup: 'Make-Up Classes',
  lmc: 'Legal Methods (Canadian Law)',
  lmb: 'Legal Methods (Business Law & ILT)',
  alrw: 'Applied Legal Research & Writing (ALRW)',
  orient: 'Orientation Evenings',
  intensive: 'Intensive Courses',
  mid: 'Mid-Term Exams',
  dmid: 'Deferred Mid-Term Exams',
  fin: 'Final Exams',
  finc: 'Final Exams (Canadian Law)',
  dfin: 'Deferred Final Exams',
};

interface Chip {
  key: string;
  labelHead: string;
  labelTail: string | null;
  swatchStyle: string;
}

function toChip(f: FilterDef): Chip {
  const meta = f.name
    ? { t: f.t!, c: f.c! }
    : { t: META[f.cats[0]].t, c: META[f.cats[0]].c };
  const raw = LABEL[f.key] ?? f.key;
  const idx = raw.indexOf('(');
  const tail = idx > 0 ? raw.slice(idx) : null;
  const wrap = tail !== null && !/^\(\w+\)$/.test(tail);
  const labelHead = wrap ? raw.slice(0, idx).trimEnd() : raw;
  const labelTail = wrap ? tail : null;
  return {
    key: f.key,
    labelHead,
    labelTail,
    swatchStyle: swatchStyle(meta.t, meta.c, 14),
  };
}

const classChips: Chip[] = FILTERS_CLASSES.map(toChip);
const examChips:  Chip[] = FILTERS_EXAMS.map(toChip);
---

<div class="filter-topbar">
  <button
    type="button"
    class="filter-clear"
    @click="reset()"
    x-show="anyFilter && !isDefault"
  >
    <span class="filter-clear-text">clear <span x-text="activeCount"></span> filter<span x-text="activeCount === 1 ? '' : 's'"></span></span> <span class="filter-clear-x">✕</span>
  </button>
</div>

<aside class="filter-bar" :data-tucked="fbHidden ? 'true' : null" role="toolbar" aria-label="Calendar filters">
  <div class="filter-inner">
    <div class="filter-row">
      <div class="filter-group" :class="{ 'is-open': classesOpen }" data-fb-group="classes">
        <button
          type="button"
          class="filter-section-label"
          @click="classesOpen = !classesOpen"
          :aria-expanded="classesOpen ? 'true' : 'false'"
          aria-controls="fb-classes-content"
        >
          <span class="filter-section-label-text">CLASSES</span>
          <span class="filter-caret" aria-hidden="true"></span>
        </button>
        <div id="fb-classes-content" class="filter-collapse">
          <div class="filter-collapse-inner">
            <div class="filter-switches">
              {classChips.map((c) => (
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  :class={`{ 'is-on': filters['${c.key}'] }`}
                  @click={`toggle('${c.key}')`}
                  :aria-checked={`filters['${c.key}'] ? 'true' : 'false'`}
                >
                  <span class="toggle-swatch" style={c.swatchStyle} aria-hidden="true"></span>
                  <span class="toggle-label">
                  {c.labelHead}
                  {c.labelTail && <><br />{c.labelTail}</>}
                </span>
                  <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="filter-row">
      <div class="filter-group" :class="{ 'is-open': examsOpen }" data-fb-group="exams">
        <button
          type="button"
          class="filter-section-label"
          @click="examsOpen = !examsOpen"
          :aria-expanded="examsOpen ? 'true' : 'false'"
          aria-controls="fb-exams-content"
        >
          <span class="filter-section-label-text">EXAMS</span>
          <span class="filter-caret" aria-hidden="true"></span>
        </button>
        <div id="fb-exams-content" class="filter-collapse">
          <div class="filter-collapse-inner">
            <div class="filter-switches">
              {examChips.map((c) => (
                <button
                  type="button"
                  class="toggle"
                  role="switch"
                  :class={`{ 'is-on': filters['${c.key}'] }`}
                  @click={`toggle('${c.key}')`}
                  :aria-checked={`filters['${c.key}'] ? 'true' : 'false'`}
                >
                  <span class="toggle-swatch" style={c.swatchStyle} aria-hidden="true"></span>
                  <span class="toggle-label">
                  {c.labelHead}
                  {c.labelTail && <><br />{c.labelTail}</>}
                </span>
                  <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
                </button>
              ))}
            </div>
            <p class="filter-note">
              Exam times: weekdays 6pm–9pm · weekends 1pm–4pm
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</aside>

<style>
  .filter-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(244, 241, 234, 0.94);
    backdrop-filter: blur(0.5rem);
    -webkit-backdrop-filter: blur(0.5rem);
    border-top: 0.0625rem solid var(--tana);
    border-bottom: 0.0625rem solid var(--tana);
    margin: 0 calc(-1 * clamp(0.875rem, 3.5vw, 2.5rem));
    padding: 0.75rem clamp(0.875rem, 3.5vw, 2.5rem);
    transition: transform 250ms ease;
    will-change: transform;
  }

  .filter-bar[data-tucked='true'] {
    transform: translateY(-100%);
  }

  .filter-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-row {
    display: block;
  }


  .filter-group {
    display: block;
    padding: 0.375rem 0.625rem;
    border: 0.0625rem solid rgba(0, 37, 84, 0.10);
    border-radius: 0.625rem;
    background: rgba(255, 255, 255, 0.55);
  }

  .filter-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s linear;
  }

  .filter-collapse > .filter-collapse-inner {
    min-height: 0;
    overflow: hidden;
    margin-top: 0.375rem;
  }

  .filter-group.is-open .filter-collapse {
    grid-template-rows: 1fr;
  }

  .filter-switches {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--tog-cell-w, 14rem));
    gap: 0.125rem 0.25rem;
    justify-content: space-between;
  }

  .filter-note {
    margin: 0.5rem 0.25rem 0.125rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--driftwood);
  }

  .filter-section-label {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 0.375rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.625rem;
    line-height: 1;
    letter-spacing: 0.2em;
    color: var(--driftwood);
    font-weight: 700;
    margin: 0;
    padding: 0.25rem;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    border: 0;
    background: transparent;
    border-radius: 0.25rem;
    text-align: left;
  }

  .filter-section-label:hover { color: var(--prussian-blue); }

  .filter-section-label:focus-visible {
    outline: 0.125rem solid var(--matisse);
    outline-offset: 0.125rem;
  }

  .filter-caret {
    display: inline-block;
    width: 0;
    height: 0;
    border-left: 0.25rem solid transparent;
    border-right: 0.25rem solid transparent;
    border-top: 0.3125rem solid currentColor;
    transition: transform 0.3s linear;
    transform: rotate(-90deg);
  }

  .filter-group.is-open .filter-caret {
    transform: rotate(0deg);
  }

  /* ---- Filter switch: [swatch] [label] [track+thumb] ---- */

  .toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem 0.375rem 0.625rem;
    min-width: 0;
    border: 0.0625rem solid transparent;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--prussian-blue);
    font-family: 'Archivo', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.3s linear,
      border-color 0.3s linear,
      color 0.3s linear;
  }

  .toggle .toggle-label { width: var(--tog-label-w, auto); }

  .toggle:focus-visible {
    outline: 0.125rem solid var(--matisse);
    outline-offset: 0.125rem;
  }

  .toggle.is-on {
    background: rgba(0, 37, 84, 0.06);
    border-color: rgba(0, 37, 84, 0.12);
  }

  .toggle-swatch {
    display: inline-block;
    flex: none;
    box-sizing: border-box;
  }

  .toggle-label {
    line-height: 1.1;
    min-width: 0;
  }

  .toggle-track {
    position: relative;
    display: inline-block;
    width: 1.625rem;
    height: 0.875rem;
    border-radius: 62.4375rem;
    background: var(--tana);
    flex: none;
    transition: background 0.3s linear;
  }

  .toggle-thumb {
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0.0625rem 0.125rem rgba(0, 0, 0, 0.25);
    transition: left 0.3s linear;
  }

  .toggle.is-on .toggle-track {
    background: var(--prussian-blue);
  }

  .toggle.is-on .toggle-thumb {
    left: 0.875rem;
  }


  /* ---- Clear link ---- */

  .filter-topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 1.125rem;
    padding: 0.25rem clamp(0.875rem, 3.5vw, 2.5rem) 0;
    margin: 0 calc(-1 * clamp(0.875rem, 3.5vw, 2.5rem));
  }

  .filter-clear {
    background: none;
    border: 0;
    padding: 0.25rem 0.125rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--matisse);
    cursor: pointer;
    text-decoration: none;
  }

  .filter-clear-text {
    text-decoration: underline;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.1875rem;
  }

  .filter-clear-x {
    display: inline-block;
    margin-left: 0.25rem;
  }

  .filter-clear:hover { color: var(--prussian-blue); }

  /* ---- Mobile: 2 columns, dial down weight/size, stretch label so tracks
     right-align consistently rather than clinging to variable text width. ---- */
  @media (max-width: 45rem) {
    .filter-switches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.125rem;
    }
    .toggle {
      font-size: 0.6875rem;
      font-weight: 400;
      padding: 0.3125rem 0.375rem 0.3125rem 0.5rem;
      gap: 0.375rem;
    }
    .toggle .toggle-label {
      width: auto;
      flex: 1;
    }
    .toggle-track {
      width: 1.375rem;
      height: 0.75rem;
    }
    .toggle-thumb {
      width: 0.5rem;
      height: 0.5rem;
    }
    .toggle.is-on .toggle-thumb {
      left: 0.75rem;
    }
  }
</style>
