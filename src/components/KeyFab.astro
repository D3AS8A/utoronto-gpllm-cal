---
---
<button type="button" class="key-fab" @click="keyOpen = true">
  <span class="key-fab__swatch" aria-hidden="true"></span>KEY &amp; FILTERS
  <template x-if="anyFilter">
    <span class="key-fab__badge" x-text="activeCount"></span>
  </template>
</button>

<style>
  .key-fab {
    position: fixed;
    right: clamp(14px, 3vw, 32px);
    bottom: clamp(14px, 3vw, 32px);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--prussian-blue);
    color: #fff;
    border: 2px solid var(--prussian-blue);
    padding: 11px 16px;
    cursor: pointer;
    box-shadow: 3px 3px 0 rgba(0, 37, 84, 0.25);
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 12.5px;
  }

  .key-fab:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 rgba(0, 37, 84, 0.28);
  }

  .key-fab__swatch {
    display: inline-block;
    width: 11px;
    height: 11px;
    background: var(--sky);
    border: 1.5px solid #fff;
  }

  .key-fab__badge {
    background: var(--sky);
    color: var(--prussian-blue);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }
</style>
