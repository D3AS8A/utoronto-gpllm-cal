---
---

<div id="pwa-update-toast" class="pwa-toast" hidden role="status" aria-live="polite">
  <span class="pwa-toast__msg">A new version is ready</span>
  <button type="button" id="pwa-update-reload" class="pwa-toast__btn">Reload</button>
  <button type="button" id="pwa-update-dismiss" class="pwa-toast__dismiss" aria-label="Dismiss">&times;</button>
</div>

<script>
  import { registerSW } from 'virtual:pwa-register';

  // Query at act time and delegate clicks: the router swaps the body on
  // every in-page navigation, detaching anything captured at load
  let updateReady = false;

  const applyUpdateUi = () => {
    const toast = document.getElementById('pwa-update-toast');
    if (toast) toast.hidden = false;
    // Stamped links navigate for real, so markup and bundle arrive from the
    // same build instead of the router mixing old script with new pages
    document
      .querySelectorAll('a[href]')
      .forEach((link) => link.setAttribute('data-astro-reload', ''));
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('#pwa-update-reload')) window.location.reload();
    if (target.closest('#pwa-update-dismiss')) {
      const toast = document.getElementById('pwa-update-toast');
      if (toast) toast.hidden = true;
    }
  });

  // Each swap brings a hidden toast and unstamped links; reapply
  document.addEventListener('astro:page-load', () => {
    if (updateReady) applyUpdateUi();
  });

  if (import.meta.env.DEV) {
    // No worker in dev; scrub any registration and caches left from when
    // devOptions was enabled
    navigator.serviceWorker?.getRegistrations().then((regs) => {
      regs.forEach((reg) => reg.unregister());
    });
    caches?.keys().then((keys) => {
      keys.forEach((key) => caches.delete(key));
    });
  } else registerSW({
    // Suppresses the autoUpdate default of reloading the page on activation
    onNeedReload() {
      updateReady = true;
      applyUpdateUi();
    },
    onOfflineReady() {
      // Silent, nothing to show for first-time offline readiness
    },

    // Browsers only check for a new worker on real navigations, which
    // client-side routing never makes; ask explicitly instead
    onRegisteredSW(_swUrl, registration) {
      if (!registration) return;

      const check = () => registration.update().catch(() => {});

      document.addEventListener('astro:page-load', check);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') check();
      });
      setInterval(check, 60 * 60 * 1000);
    },
  });
</script>

<style lang="scss">
  .pwa-toast {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem 0.6rem 1rem;
    background: #002554;
    color: #f4f1ea;
    border-radius: 0.375rem;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.2);
    font-size: 0.875rem;
    line-height: 1.2;
    max-width: calc(100vw - 2rem);
  }

  .pwa-toast[hidden] {
    display: none;
  }

  .pwa-toast__msg {
    white-space: nowrap;
  }

  .pwa-toast__btn {
    background: #f4f1ea;
    color: #002554;
    border: 0;
    padding: 0.35rem 0.65rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      background: #fff;
    }
  }

  .pwa-toast__dismiss {
    background: transparent;
    color: #f4f1ea;
    border: 0;
    font-size: 1.25rem;
    line-height: 1;
    padding: 0 0.25rem;
    cursor: pointer;
    opacity: 0.7;

    &:hover,
    &:focus-visible {
      opacity: 1;
    }
  }
</style>
