---

<div id="pwa-update-toast" class="pwa-toast" hidden role="status" aria-live="polite">
  <span class="pwa-toast__msg">A new version is ready</span>
  <button type="button" id="pwa-update-reload" class="pwa-toast__btn">Reload</button>
  <button type="button" id="pwa-update-dismiss" class="pwa-toast__dismiss" aria-label="Dismiss">&times;</button>
</div>

<script>
  import { registerSW } from 'virtual:pwa-register';

  const toast = document.getElementById('pwa-update-toast');
  const reloadBtn = document.getElementById('pwa-update-reload');
  const dismissBtn = document.getElementById('pwa-update-dismiss');

  const updateSW = registerSW({
    onNeedRefresh() {
      if (toast) toast.hidden = false;
    },
    onOfflineReady() {
      // Silent — no UI needed for first-time offline readiness
    },

    /*
     * A browser only checks for a new service worker on a real navigation.
     * This site routes on the client, so clicking between pages never
     * triggers that check and a returning visitor can sit on a stale worker
     * indefinitely, which is why updates only appeared after a hard reload.
     * Asking explicitly is what makes the toast show up on its own.
     */
    onRegisteredSW(_swUrl, registration) {
      if (!registration) return;

      const check = () => registration.update().catch(() => {});

      document.addEventListener('astro:page-load', check);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') check();
      });
      setInterval(check, 60 * 60 * 1000);
    },
  });

  reloadBtn?.addEventListener('click', () => {
    updateSW(true);
  });

  dismissBtn?.addEventListener('click', () => {
    if (toast) toast.hidden = true;
  });
</script>

<style lang="scss">
  .pwa-toast {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem 0.6rem 1rem;
    background: #002554;
    color: #f4f1ea;
    border-radius: 0.375rem;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.2);
    font-size: 0.875rem;
    line-height: 1.2;
    max-width: calc(100vw - 2rem);
  }

  .pwa-toast[hidden] {
    display: none;
  }

  .pwa-toast__msg {
    white-space: nowrap;
  }

  .pwa-toast__btn {
    background: #f4f1ea;
    color: #002554;
    border: 0;
    padding: 0.35rem 0.65rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      background: #fff;
    }
  }

  .pwa-toast__dismiss {
    background: transparent;
    color: #f4f1ea;
    border: 0;
    font-size: 1.25rem;
    line-height: 1;
    padding: 0 0.25rem;
    cursor: pointer;
    opacity: 0.7;

    &:hover,
    &:focus-visible {
      opacity: 1;
    }
  }
</style>
