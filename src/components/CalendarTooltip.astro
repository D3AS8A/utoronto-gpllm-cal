---
---
<div
  id="cal-tooltip"
  class="cal-tt"
  role="tooltip"
  :class="{ 'is-visible': tooltip.visible, 'is-traveling': tooltip.travel, 'cal-tt--below': tooltip.below }"
  :style="`--tt-x:${tooltip.x}px;--tt-top:${tooltip.yTop}px;--tt-bottom:${tooltip.yBottom}px;--tt-head:${tooltipHeadBg}`"
  @mouseenter="cancelHideTooltip()"
  @mouseleave="hideTooltip(0)"
  @click="openTooltipDetail()"
>
  <div class="cal-tt__stack">
    <div class="cal-tt__slot" :class="{ 'is-active': tooltip.active === 0 }" aria-hidden="tooltip.active !== 0">
      <template x-if="tooltip.slot0">
        <div class="cal-tt__inner">
          <p class="cal-tt__date">
            <span x-text="tooltip.slot0.weekday"></span>
            <span class="cal-tt__sep" aria-hidden="true">·</span>
            <span x-text="tooltip.slot0.dateLabel"></span>
          </p>
          <ul class="cal-tt__list">
            <template x-for="item in tooltip.slot0.items" :key="item.name">
              <li class="cal-tt__item">
                <span class="cal-tt__swatch" :style="item.swatchStyle" aria-hidden="true"></span>
                <span class="cal-tt__body">
                  <span class="cal-tt__name" x-text="item.name"></span>
                  <span class="cal-tt__time" x-text="item.time"></span>
                </span>
              </li>
            </template>
          </ul>
        </div>
      </template>
    </div>
    <div class="cal-tt__slot" :class="{ 'is-active': tooltip.active === 1 }" aria-hidden="tooltip.active !== 1">
      <template x-if="tooltip.slot1">
        <div class="cal-tt__inner">
          <p class="cal-tt__date">
            <span x-text="tooltip.slot1.weekday"></span>
            <span class="cal-tt__sep" aria-hidden="true">·</span>
            <span x-text="tooltip.slot1.dateLabel"></span>
          </p>
          <ul class="cal-tt__list">
            <template x-for="item in tooltip.slot1.items" :key="item.name">
              <li class="cal-tt__item">
                <span class="cal-tt__swatch" :style="item.swatchStyle" aria-hidden="true"></span>
                <span class="cal-tt__body">
                  <span class="cal-tt__name" x-text="item.name"></span>
                  <span class="cal-tt__time" x-text="item.time"></span>
                </span>
              </li>
            </template>
          </ul>
        </div>
      </template>
    </div>
  </div>
  <p class="cal-tt__hint" aria-hidden="true">details</p>
</div>

<style>
  .cal-tt {
    position: fixed;
    left: var(--tt-x);
    top: var(--tt-top);
    transform: translate(-50%, calc(-100% - 0.625rem));
    z-index: 60;
    min-width: 12.5rem;
    max-width: 17.5rem;
    background: #fff;
    border: 0.09375rem solid var(--prussian-blue);
    border-top: 0.25rem solid var(--tt-head, var(--prussian-blue));
    box-shadow: 0 0.375rem 1.125rem rgba(0, 37, 84, 0.16);
    padding: 0.625rem 0.75rem 0.5rem;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms ease-out;
  }

  .cal-tt.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Travel mode: position + head-color glide between anchors. */
  .cal-tt.is-traveling {
    transition:
      left 200ms cubic-bezier(0.4, 0, 0.2, 1),
      top 200ms cubic-bezier(0.4, 0, 0.2, 1),
      border-top-color 200ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 120ms ease-out;
  }

  .cal-tt.is-traveling::after {
    transition: border-color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Flip below the cell when the cell is near the top of the viewport. */
  .cal-tt--below {
    top: var(--tt-bottom);
    transform: translate(-50%, 0.625rem);
  }

  /* Small arrow pointing at the cell */
  .cal-tt::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.4375rem;
    transform: translateX(-50%) rotate(45deg);
    width: 0.625rem;
    height: 0.625rem;
    background: #fff;
    border-right: 0.09375rem solid var(--prussian-blue);
    border-bottom: 0.09375rem solid var(--prussian-blue);
  }

  .cal-tt--below::after {
    bottom: auto;
    top: -0.4375rem;
    border-right: none;
    border-bottom: none;
    border-left: 0.09375rem solid var(--prussian-blue);
    border-top: 0.25rem solid var(--tt-head, var(--prussian-blue));
  }

  /* Double-buffered content stack — slots share the same grid cell so the
     container height is driven by whichever slot has taller content. */
  .cal-tt__stack {
    display: grid;
    grid-template-areas: 'stack';
  }

  .cal-tt__slot {
    grid-area: stack;
    opacity: 0;
    min-width: 0;
  }

  .cal-tt__slot.is-active {
    opacity: 1;
  }

  /* Slot crossfade only kicks in during travel — fresh entry snaps content
     to its committed state under the container's opacity fade. */
  .cal-tt.is-traveling .cal-tt__slot {
    transition: opacity 140ms ease-out;
  }

  .cal-tt.is-traveling .cal-tt__slot.is-active {
    transition-delay: 40ms;
  }

  .cal-tt__inner {
    display: contents;
  }

  .cal-tt__date {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--driftwood);
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.375rem;
  }

  .cal-tt__date > span:last-child {
    color: var(--prussian-blue);
    letter-spacing: 0.02em;
  }

  .cal-tt__sep { opacity: 0.5; }

  .cal-tt__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cal-tt__item {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .cal-tt__swatch {
    display: block;
    flex: none;
    margin-top: 0.125rem;
  }

  .cal-tt__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cal-tt__name {
    font-weight: 700;
    font-size: 0.8125rem;
    line-height: 1.25;
    color: var(--prussian-blue);
  }

  .cal-tt__time {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    color: var(--pablo);
    margin-top: 0.0625rem;
  }

  .cal-tt__hint {
    margin: 0.5rem 0 0;
    padding-top: 0.375rem;
    border-top: 0.0625rem dashed var(--tana);
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    color: var(--matisse);
    font-weight: 500;
    text-align: center;
    text-decoration: underline;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.1875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cal-tt,
    .cal-tt.is-traveling,
    .cal-tt.is-traveling::after,
    .cal-tt.is-traveling .cal-tt__slot {
      transition: opacity 80ms linear;
    }
  }

  /* Desktop-only: hide on touch / coarse pointers and narrow viewports.
     The showTooltip() method also gates on matchMedia — this is the visual
     safety net. */
  @media (hover: none), (pointer: coarse), (max-width: 44.9375rem) {
    .cal-tt { display: none; }
  }
</style>
