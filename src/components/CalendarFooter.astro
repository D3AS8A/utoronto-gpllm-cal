---
---
<footer class="cal-footer">
  <section class="cal-footer__col" aria-labelledby="footer-note-label">
    <h2 id="footer-note-label" class="cal-footer__label">PLEASE NOTE</h2>
    <p>
      Dates and times herein are subject to change. For course-specific dates and times,
      please consult syllabi on <strong>Quercus</strong>.
    </p>
  </section>
  <section class="cal-footer__col" aria-labelledby="footer-times-label">
    <h2 id="footer-times-label" class="cal-footer__label">MID-TERM &amp; FINAL EXAM TIMES</h2>
    <p>Weekdays 6pm – 9pm&nbsp;&nbsp;·&nbsp;&nbsp;Weekends 1pm – 4pm</p>
  </section>
  <div class="cal-footer__mark">
    <img
      src="/images/uoft-law-logo.png"
      alt="Henry N.R. Jackman Faculty of Law, University of Toronto"
      class="cal-footer__uoft"
    />
  </div>
</footer>

<style>
  .cal-footer {
    margin-top: clamp(32px, 4.5vw, 56px);
    border-top: 2px solid var(--prussian-blue);
    padding-top: 18px;
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .cal-footer__col:first-child { max-width: 440px; }
  .cal-footer__col:last-child  { max-width: 360px; }

  .cal-footer__label {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--driftwood);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .cal-footer p {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--oxford-blue);
  }

  .cal-footer strong {
    color: var(--prussian-blue);
  }

  .cal-footer__mark {
    flex: 1 0 100%;
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  .cal-footer__uoft {
    height: clamp(34px, 4vw, 46px);
    width: auto;
    display: block;
    opacity: 0.9;
  }

  @media (min-width: 900px) {
    .cal-footer__mark {
      flex: 0 0 auto;
      align-items: flex-start;
      align-self: flex-start;
      margin-top: 0;
    }
  }
</style>
