---
import { formatUpdated } from '../lib/date';

interface Props {
  /** ISO YYYY-MM-DD of the last manual content update. */
  lastUpdated?: string;
}
const { lastUpdated } = Astro.props;

const updatedLabel = formatUpdated(lastUpdated);
---
<footer class="cal-footer">
  <div class="footer-col-stack">
    <section class="footer-col" aria-labelledby="footer-note-label">
      <h2 id="footer-note-label" class="footer-label">PLEASE NOTE</h2>
      <p>
        Dates and times herein are subject to change. For course-specific dates and times,
        please consult syllabi on <a href="https://idpz.utorauth.utoronto.ca/idp/profile/SAML2/Redirect/SSO?execution=e1s1" target="_blank" rel="noopener"><strong>Quercus</strong></a>.
      </p>
    </section>
    {updatedLabel && (
      <section class="footer-col" aria-labelledby="footer-updated-label">
        <h2 id="footer-updated-label" class="footer-label">LAST UPDATED</h2>
        <p>
          <em><time datetime={lastUpdated}>{updatedLabel}</time></em>
        </p>
      </section>
    )}
  </div>
  <section class="footer-col mobile" aria-labelledby="footer-viewport-label">
    <h2 id="footer-viewport-label" class="footer-label">VIEWPORT</h2>
    <p>
      This calendar is fully functional on mobile devices, however a larger screen is recommended for a better view of the calendar.
    </p>
  </section>
  <div class="footer-mark">
    <img
      src="/images/jackman-law-logo.png"
      alt="Henry N.R. Jackman Faculty of Law, University of Toronto"
      class="footer-uoft-mark"
    />
  </div>
</footer>

<style>
  .cal-footer {
    margin-top: clamp(2rem, 4.5vw, 3.5rem);
    border-top: 0.125rem solid var(--prussian-blue);
    padding-top: 1.125rem;
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .footer-col-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 27.5rem;
  }

  .footer-col:last-child  { max-width: 22.5rem; }

  .footer-col.mobile { display: none; }

  @media (max-width: 45rem) {
    .footer-col.mobile { display: block; }
  }

  .footer-label {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--driftwood);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .cal-footer p {
    font-size: 0.8125rem;
    line-height: 1.5;
    font-weight: 500;
    color: var(--oxford-blue);
  }

  .cal-footer strong {
    color: var(--prussian-blue);
  }

  .footer-mark {
    flex: 1 0 100%;
    display: flex;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }

  .footer-uoft-mark {
    height: clamp(1.875rem, 3.5vw, 2.5rem);
    width: auto;
    display: block;
    opacity: 0.9;
  }


  @media (min-width: 56.25rem) {
    .footer-mark {
      flex: 0 0 auto;
      align-items: flex-start;
      align-self: flex-start;
      margin-top: 0;
    }
  }
</style>
