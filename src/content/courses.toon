meta:
  title: Courses
  description: The 2026-2027 course offerings for the GPLLM program at the UofT Jackman faculty of law.
  og_image: /images/og-image.png

options: null

content:
  eyebrow: 2026-2027 ACADEMIC YEAR
  eyebrow_datetime: 2026-09/2027-08
  heading: Courses
  intro: All GPLLM courses are attended in person, with no remote option. Classes run on Friday evenings and Saturdays on alternating weekends, with intensive courses in December and April.
  requirements: "The degree requires exactly ten courses: the required Friday evening course for your concentration in the fall term, four more from your concentration, and five from any concentration."
  desc_placeholder: "A full description for {title} is on its way. Until then, the official course description is available on the GPLLM website."
  last_updated: "2026-09-11"

  concentrations[3]{key,label,short}:
    cl,Canadian Law,CAN
    bl,Business Law,BUS
    ilt,Technology Law,TECH

  program_courses[3]{key,code,kind,title,when,conc,capped,nca,desc}:
    lm-cdn,,Intensive,Legal Methods (Canadian Law),"September 10, 11, 17 & 18 · 9:30 a.m. – 4:30 p.m.",cl,false,false,"A broad overview of the foundational legal concepts key to success in the program: cases, the evolution of the common law, sources of Canadian law, and methods of legal analysis. Classes are interactive, with time for questions and discussion. September 18 covers Foundations of Canadian Law as a full day."
    lm-bus,,Intensive,Legal Methods (Business & Technology Law),"September 12, 13, 19 & 20 · 9:30 a.m. – 4:30 p.m.",bl/ilt,false,false,"A broad overview of the foundational legal concepts key to success in the program: cases, the evolution of the common law, sources of Canadian law, and methods of legal analysis. Each topic is designed to teach you how to use your time effectively as you tackle readings and assignments. Lectures build on each other, so attending all four days is highly recommended."
    alrw,LAW4024H,NCA requirement,Applied Legal Research and Writing,"September 12, 13, 19 & 20 · 9:30 a.m. – 5:30 p.m.",cl,false,true,"Designed for internationally trained lawyers pursuing a Certificate of Qualification through the National Committee on Accreditation (NCA) who are registered in the Canadian Law concentration. Business Law and Technology Law students with an international law degree can instead enroll in the Legal Research and Writing course offered through CPLED to satisfy this NCA requirement."

