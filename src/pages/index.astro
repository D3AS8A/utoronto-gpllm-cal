---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadGlobal, loadPage } from '../lib/content';
import CalendarHeader from '../components/CalendarHeader.astro';
import CalendarFooter from '../components/CalendarFooter.astro';
import FilterBar from '../components/FilterBar.astro';
import CalendarSection from '../components/CalendarSection.astro';
import DetailModal from '../components/DetailModal.astro';
import CalendarTooltip from '../components/CalendarTooltip.astro';

const global = loadGlobal();
const { meta } = loadPage('home');

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: global.name,
  description: global.description,
  url: global.url,
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
  jsonLD={jsonLD}
  showChrome={false}
>
  <div
    class="cal-app rails-on"
    :class="{ 'no-scroll': detail }"
    x-data="calendar"
    x-cloak
    @keydown.escape.window="detail = null; tooltip = null"
  >
    <CalendarHeader />

    <FilterBar />

    <main id="main-content" class="cal-main" tabindex="-1">
      <CalendarSection season="fall" />
      <CalendarSection season="winter" />
      <CalendarSection season="summer" />
    </main>

    <CalendarFooter />

    <DetailModal />
    <CalendarTooltip />
  </div>
</BaseLayout>

<style is:global>
  /* Overrides for the calendar page — global.scss paints a dark chrome; the
     calendar's warm cream palette lives here. */
  body:has(.cal-app) {
    /* Undo global.scss's flex-column layout — .cal-app relies on plain block
       flow so `max-width` + `margin: 0 auto` centers as expected. */
    display: block;
    background: var(--satin-linen);
    color: var(--prussian-blue);
    font-family: 'Archivo', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body:has(.cal-app) ::selection {
    background: var(--sky);
    color: var(--prussian-blue);
  }

  .gp-scroll::-webkit-scrollbar { height: 6px; }
  .gp-scroll::-webkit-scrollbar-thumb { background: var(--chino); }

  @keyframes gpPop    { 0% { transform: translateY(14px) scale(0.98); opacity: 0; } 100% { transform: none; opacity: 1; } }
  @keyframes gpFade   { from { opacity: 0; } to { opacity: 1; } }
  @keyframes gpDrawer { from { transform: translateX(48px); opacity: 0; } to { transform: none; opacity: 1; } }
</style>

<style>
  .cal-app {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(14px, 3.5vw, 40px) 80px;
  }

  .cal-main {
    margin-top: clamp(20px, 2.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: clamp(30px, 4vw, 52px);
  }
</style>
