---
import PageLayout from '../layouts/PageLayout.astro';
import { loadGlobal, loadPage, loadModified } from '../lib/content';
import { courseEventIndex } from '../lib/courses';
import PageTitle from '../components/PageTitle.astro';
import FilterBar from '../components/FilterBar.astro';
import CalendarSection from '../components/CalendarSection.astro';
import DetailModal from '../components/DetailModal.astro';
import CalendarTooltip from '../components/CalendarTooltip.astro';

const global = loadGlobal();
const { meta, content } = loadPage<{
  eyebrow: string;
  eyebrow_datetime: string;
  heading: string;
}>('calendar');
const lastUpdated = loadModified();

/* Emitted once for the whole page rather than per cell: the same Saturday
   courses recur across thirty dates, and their descriptions are long. Cells
   carry only refs into this. */
const courseIndex = courseEventIndex();

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: global.name,
  description: global.description,
  url: global.url,
};
---

<PageLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
  jsonLD={jsonLD}
  lastUpdated={lastUpdated}
>
  <PageTitle
    eyebrow={content.eyebrow}
    eyebrowDatetime={content.eyebrow_datetime}
    title={content.heading}
  >
    <p>
      Regular classes take place on <strong>Friday evenings</strong> (4–9pm) and
      <strong>Saturdays</strong> (8:30am–6:30pm). Select any coloured date for details,
      or open the key to filter by session type.
    </p>
  </PageTitle>

  <div
    :class="{ 'no-scroll': detail }"
    x-data="calendar"
    x-cloak
    @keydown.escape.window="detail = null; tooltip = null"
  >
    <FilterBar />

    <main id="main-content" class="cal-main" tabindex="-1">
      <CalendarSection season="fall" />
      <CalendarSection season="winter" />
      <CalendarSection season="summer" />
    </main>

    <DetailModal />
    <CalendarTooltip />

    <script
      type="application/json"
      id="gp-course-index"
      set:html={JSON.stringify(courseIndex)}
    />
  </div>
</PageLayout>

<style is:global>
  .gp-scroll::-webkit-scrollbar { height: 0.375rem; }
  .gp-scroll::-webkit-scrollbar-thumb { background: var(--chino); }

  @keyframes gpPop    { 0% { transform: translateY(0.875rem) scale(0.98); opacity: 0; } 100% { transform: none; opacity: 1; } }
  @keyframes gpFade   { from { opacity: 0; } to { opacity: 1; } }
  @keyframes gpDrawer { from { transform: translateX(3rem); opacity: 0; } to { transform: none; opacity: 1; } }
</style>

<style>
  .cal-main {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: clamp(1.875rem, 4vw, 3.25rem);
  }
</style>
