---
import PageLayout from '../layouts/PageLayout.astro';
import { loadPage, loadModified } from '../lib/content';
import PageTitle from '../components/PageTitle.astro';
import CourseCard, { type RunDef } from '../components/CourseCard.astro';
import CourseSection, { type TimeEntry } from '../components/CourseSection.astro';
import SortToggle from '../components/SortToggle.astro';
import ConcentrationFilter from '../components/ConcentrationFilter.astro';
import type { CourseDef } from '../components/CourseCard.astro';

interface CatalogRow {
  code: string;
  title: string;
  conc: string;
  capped: boolean;
  nca: boolean;
  req: boolean;
}

/** Instructor and description, scraped per course from the faculty site. */
interface DetailRow {
  code: string;
  credits: number;
  slug: string;
  desc: string;
}

/** One scheduled run: its room, and who teaches that run. */
interface OfferingRow {
  ref: string;
  room: string;
  prof: string;
}

interface ProfileRow {
  name: string;
  path: string;
}

/** Non-credit and NCA courses: no course code, own schedule and description. */
interface ProgramRow {
  key: string;
  code: string;
  kind: string;
  title: string;
  when: string;
  conc: string;
  capped: boolean;
  nca: boolean;
  desc: string;
}

interface Slot {
  name: string;
  time: string;
  courses: string;
  note: string;
}

interface Term {
  no: string;
  label: string;
  range: string;
  slots: Slot[];
}

const { meta, content } = loadPage<{
  eyebrow: string;
  eyebrow_datetime: string;
  heading: string;
  intro: string;
  requirements: string;
  course_url_base: string;
  desc_placeholder: string;
  last_updated?: string;
  concentrations: Array<{ key: string; label: string; short: string }>;
  program_courses: ProgramRow[];
  details: DetailRow[];
  offerings: OfferingRow[];
  profiles: ProfileRow[];
  profile_url_base: string;
  catalog: CatalogRow[];
  terms: Record<string, Term>;
}>('courses');

const concLabels = Object.fromEntries(
  content.concentrations.map((c) => [c.key, { label: c.label, short: c.short }]),
);

const details = Object.fromEntries(content.details.map((row) => [row.code, row]));
const profiles = Object.fromEntries(content.profiles.map((row) => [row.name, row.path]));

// Instructors are stored as one string; split them out and attach a profile
// link where the faculty directory lists one
const offerings = Object.fromEntries(
  content.offerings.map((row) => [
    row.ref,
    {
      ...row,
      people: row.prof
        ? row.prof.split(', ').map((name) => ({
            name,
            url: profiles[name] ? `${content.profile_url_base}${profiles[name]}` : undefined,
          }))
        : [],
    },
  ]),
);

const catalog: Record<string, CourseDef> = Object.fromEntries([
  ...content.catalog.map((row) => [
    row.code,
    { ...row, ...details[row.code], conc: row.conc.split('/') },
  ]),
  ...content.program_courses.map((row) => [
    row.key,
    {
      ...row,
      credits: row.code ? details[row.code]?.credits : undefined,
      slug: row.code ? details[row.code]?.slug : undefined,
      code: row.code || undefined,
      req: false,
      conc: row.conc.split('/'),
    },
  ]),
]);

/*
  The schedule is stored term by term, which lists a course once per run. A
  catalogue wants the opposite: one entry per course, carrying its runs. So
  walk the terms in calendar order and collect each course's runs as we meet
  them. Courses taught twice (Constitutional Law, Criminal Law, Professional
  Responsibility, Aboriginal Law) collapse into a single entry here.
*/
const byCourse = new Map<string, { course: CourseDef; runs: RunDef[] }>();

for (const term of Object.values(content.terms)) {
  for (const slot of term.slots) {
    for (const ref of slot.courses.split('|')) {
      const key = ref.split(' ')[0];
      const course = catalog[key];
      if (!course) continue;

      const entry = byCourse.get(key) ?? { course, runs: [] };
      entry.runs.push({
        term: term.label,
        slot: slot.name,
        time: slot.time,
        room: offerings[ref]?.room ?? '',
        people: offerings[ref]?.people ?? [],
      });
      byCourse.set(key, entry);
    }
  }
}

/** "Saturday Mornings" reads as shouting mid-sentence; "Saturday mornings" doesn't. */
const sentence = (slot: string) => slot.charAt(0) + slot.slice(1).toLowerCase();

/*
  The time-of-day view keeps the schedule's own shape, so a course taught twice
  appears twice. Each card names where its twin sits, which is more use than
  numbering them: nothing makes one run the "first".
*/
const timeView = Object.entries(content.terms).map(([id, term]) => ({
  id,
  label: term.label,
  range: term.range,
  slots: term.slots.map((slot) => ({
    name: slot.name,
    time: slot.time,
    note: slot.note,
    entries: slot.courses.split('|').map((ref): TimeEntry => {
      const key = ref.split(' ')[0];
      const run: RunDef = {
        term: term.label,
        slot: slot.name,
        time: slot.time,
        room: offerings[ref]?.room ?? '',
        people: offerings[ref]?.people ?? [],
      };
      const twin = (byCourse.get(key)?.runs ?? []).find(
        (other) => other.term !== run.term || other.slot !== run.slot,
      );
      return {
        course: catalog[key],
        run,
        also: twin
          ? twin.slot !== run.slot
            ? `Also ${sentence(twin.slot)}`
            : `Also in ${twin.term.toLowerCase()}`
          : undefined,
      };
    }),
  })),
}));

// Non-credit intensives lead, since they run before term; the rest by code
const courses = [...byCourse.values()].sort((a, b) => {
  const left = a.course.code ?? '';
  const right = b.course.code ?? '';
  if (!left !== !right) return left ? 1 : -1;
  return left.localeCompare(right);
});
---

<PageLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
  lastUpdated={loadModified().courses ?? content.last_updated}
>
  <PageTitle
    eyebrow={content.eyebrow}
    eyebrowDatetime={content.eyebrow_datetime}
    title={content.heading}
  >
    <p>{content.intro}</p>
    <p>{content.requirements}</p>
  </PageTitle>

  <div
    class="courses-app"
    x-data="courseFilters"
    :class="{
      'show-cl': conc.cl,
      'show-bl': conc.bl,
      'show-ilt': conc.ilt,
      'sort-course': sort === 'course',
      'sort-time': sort === 'time',
    }"
  >
    <ConcentrationFilter concentrations={content.concentrations}>
      <SortToggle
        options={[
          { key: 'course', label: 'Course' },
          { key: 'time', label: 'Time of day' },
        ]}
      />
    </ConcentrationFilter>

    <main id="main-content" class="courses-main" tabindex="-1">
      <p class="courses-empty" x-show="!anyOn" x-transition.opacity.duration.250ms x-cloak>
        Nothing selected, choose at least one concentration on to see courses
      </p>

      <div class="courses-views">
        <div class="courses-view view-time">
        {timeView.map((term) => (
          <CourseSection
            id={term.id}
            label={term.label}
            range={term.range}
            slots={term.slots}
            concLabels={concLabels}
            placeholder={content.desc_placeholder}
            urlBase={content.course_url_base}
          />
        ))}
      </div>

        <ol class="courses-view view-course courses-list" role="list">
        {courses.map(({ course, runs }) => (
          <li>
            <CourseCard
              course={course}
              runs={runs}
              concLabels={concLabels}
              placeholder={content.desc_placeholder}
              urlBase={content.course_url_base}
            />
          </li>
        ))}
        </ol>
      </div>

    </main>
  </div>
</PageLayout>

<style is:global>
  /* Filtering is declarative: the Alpine root carries show-cl / show-bl /
     show-ilt, and a course appears when it belongs to a shown concentration.
     A course in two concentrations survives either one.

     .courses-app is doubled to outweigh the components' own scoped rules:
     `.cslot[data-astro-cid-…] { display: grid }` ties this on specificity and
     would win on source order, leaving empty slot headings behind. */
  .courses-app.courses-app .course-card,
  .courses-app.courses-app .cslot,
  .courses-app.courses-app .cterm {
    display: none;
  }

  .courses-app.show-cl .course-card[data-conc~='cl'],
  .courses-app.show-bl .course-card[data-conc~='bl'],
  .courses-app.show-ilt .course-card[data-conc~='ilt'] {
    display: block;
  }

  /* Only in the time view, where terms and slots exist to be emptied */
  .courses-app.show-cl .cterm:has(.course-card[data-conc~='cl']),
  .courses-app.show-bl .cterm:has(.course-card[data-conc~='bl']),
  .courses-app.show-ilt .cterm:has(.course-card[data-conc~='ilt']) {
    display: block;
  }

  .courses-app.show-cl .cslot:has(.course-card[data-conc~='cl']),
  .courses-app.show-bl .cslot:has(.course-card[data-conc~='bl']),
  .courses-app.show-ilt .cslot:has(.course-card[data-conc~='ilt']) {
    display: grid;
  }

  /* Both views are rendered; the sort switch decides which is in play */
  .courses-app:not(.sort-time) .view-time,
  .courses-app:not(.sort-course) .view-course {
    display: none;
  }
</style>

<style>
  /* Blog-style reading column: one column of cards with generous margins
     either side on larger screens */
  .courses-views {
    transition: opacity 170ms ease;
  }

  .courses-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .courses-list li {
    list-style: none;
  }

  .courses-main {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
  }

  .courses-empty {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--pablo);
    margin: 0;
  }

</style>
